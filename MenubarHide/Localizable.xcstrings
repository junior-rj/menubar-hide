    },
    "Show Hidden Icons in Panel" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar Ícones Ocultos no Painel"
          }
        }
      }
    },
    "Show the hidden icons first, then save." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre os ícones ocultos antes de salvar."
          }
        }
      }
    },
    "Space around each menu bar icon, in points (%lld–%lld). Smaller values fit more icons; the macOS default is around 12." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço ao redor de cada ícone da barra de menus, em pontos (%lld–%lld). Valores menores cabem mais ícones; o padrão do macOS é cerca de 12."
          }
        }
      }
    },
    "Spacing not changed" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaçamento não alterado"
          }
        }
      }
