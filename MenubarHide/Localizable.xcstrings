    },
    "About MenubarHide" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre o MenubarHide"
          }
        }
      }
    },
    "Accessibility permission needed" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão de Acessibilidade necessária"
          }
        }
      }
    },
