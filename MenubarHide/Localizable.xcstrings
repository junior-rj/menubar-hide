      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "Open System Settings" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir os Ajustes do Sistema"
          }
        }
      }
    },
    "Quit MenubarHide" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o MenubarHide"
          }
        }
      }
    },
    "Reset to macOS Default" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o Padrão do macOS"
          }
        }
      }
    },
    "Restore Saved Arrangement" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar Disposição Salva"
